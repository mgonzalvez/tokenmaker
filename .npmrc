# Personal project: always use the public npm registry.
# The machine-level ~/.npmrc points at Apple's internal mirror (npm.apple.com),
# which is unreachable from GitHub Actions and would write unresolvable
# "resolved" URLs into package-lock.json if a dependency is ever added.
# This file has no dependencies today (the app is framework-free Node/HTML),
# but it protects any future `npm install` in this repo.
registry=https://registry.npmjs.org
